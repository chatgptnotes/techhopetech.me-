# Instagram professional publishing through Facebook Login for Business.
# In Meta for Developers, add this valid OAuth redirect URI:
# https://hopetech.me/api/hopetech/instagram/callback
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_LOGIN_CONFIG_ID=your-facebook-login-for-business-config-id
META_PAGE_ID=your-facebook-page-id
META_GRAPH_API_VERSION=v25.0
META_INSTAGRAM_SCOPES=pages_show_list instagram_basic instagram_content_publish pages_read_engagement
META_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
META_OAUTH_STATE_SECRET=replace-with-another-random-secret

# Optional two-way CRM contact sync. Create a HubSpot private app with
# crm.objects.contacts.read and crm.objects.contacts.write scopes.
HUBSPOT_ACCESS_TOKEN=your-private-app-access-token
